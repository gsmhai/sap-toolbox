{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAPToolbox",
  "version": "1.0.0",
  "identifier": "com.sap.toolbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAP工具箱",
        "width": 780,
        "height": 690,
        "minWidth": 550,
        "minHeight": 290,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
